# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# .env IS GITIGNORED — never commit the real one.

# Private key of the SENDING wallet (64 hex chars, with or without 0x).
# Use a throwaway/test key while learning. Testnets are free.
PRIVATE_KEY=

# OPTIONAL: custom RPC endpoint (overrides the built-in public RPC of the selected chain)
# e.g. your own node, Alchemy, Infura, QuickNode…
RPC_URL=

# OPTIONAL: default chain (name or id) — can still be overridden per run
# CHAIN=bsc
